{
	"name": "68publishers/notification-bundle",
	"description": "Nette extension for user's notifications, flash messages also with Toastr (JS library) support.",
	"keywords": ["68publishers", "notification", "notification-bundle", "nette"],
	"license": "MIT",
	"authors": [
		{
			"name": "Tomáš Glawaty",
			"email": "tomasglawaty@icloud.com"
		}
	],
	"require": {
		"php": "^8.3",
		"68publishers/smart-nette-component": "^2.0",
		"68publishers/translation-bridge": "^3.0",
		"nette/application": "^3.1.15",
		"nette/caching": "^3.1",
		"nette/di": "^3.1.3",
		"nette/http": "^3.1",
		"nette/security": "^3.1.4",
		"nette/utils": "^3.2.10 || ^4.0.1"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.89",
		"latte/latte": "^3.0",
		"nette/bootstrap": "^3.1",
		"nette/tester": "^2.6",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"psr-4": {
			"SixtyEightPublishers\\NotificationBundle\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SixtyEightPublishers\\NotificationBundle\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
